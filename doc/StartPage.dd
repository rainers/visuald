Ddoc

$(TABLE_NOBORDER
$(TD $(IMG images/vd_logo.png))
$(TD
$(P Visual D is a Visual Studio package that provides project management, language services, and debugger integration.
It works with Visual Studio 2008 - 2026 including Professional and Community versions.
See the $(LINK2 Installation.html, Installation) instructions, especially if using older versions
of Visual Studio.)

$(P Visual D aims to provide seamless integration of the D programming language into Visual Studio.)
))

$(TABLE_NOBORDER
 $(TR
  $(TD)
  $(TD Latest release: Visual D $(VERSION))
 )
 $(TR
  $(TD If you are just starting with the D programming language and don't have a compiler installed, then this download
  provides you with everything to get you started with writing D program in Visual Studio including the reference
  compiler DMD $(DMD_VERSION) and the LLVM-based compiler LDC $(LDC_VERSION):)
  $(TD
  <span>
  <div align="right">
  $(LINK2 https://github.com/dlang/visuald/releases/download/v$(VERSION)/VisualD-v$(VERSION)-dmd-$(DMD_VERSION)-ldc2-$(LDC_VERSION).exe, $(IMG images/download_with_dmdldc2.png))
  </div>
  <div align="right"><small>download size approx 110 MB</small></div>
  </span>
 ))
 $(TR
  $(TD If you are a Visual D user or have a D compiler already installed, then this download
  provides you with an update to enhance your experience in Visual Studio:)
  $(TD
  <div align="right">
  $(LINK2 https://github.com/dlang/visuald/releases/download/v$(VERSION)/VisualD-v$(VERSION).exe, $(IMG images/download_extension2.png))
  </div>
  <div align="right"><small>download size approx 12 MB</small></div>
 ))
 $(TR
  $(TD Cutting edge prereleases if you want to try the most recent improvements to Visual D:)
  $(TD
  <div align="right">
  $(P $(LINK2 https://github.com/dlang/visuald/releases, Beta releases))
  </div>
 ))
)


$(H2 Overview)

$(P Use the navigation bar on the left to take a tour of Visual D including a lot of screen shots.)

$(TABLE_NOBORDER
$(TD
$(UL
 $(LI Project management with all DMD options available through the UI)
 $(LI Seamless VC project integration)
 $(LI Syntax highlighting with special version and token string support)
 $(LI Code completion and tooltips based on semantic analysis of source code)
 $(LI Underlining of syntax errors)
 $(LI Go to definition)
 $(LI Parameter information tooltips)
 $(LI Code outlining)
 $(LI Symbol/File search window)
 $(LI Integration with the Visual Studio debugger through native D expression evaluation
      or custom debug engine $(LINK2 https://github.com/rainers/mago, Mago))
 $(LI Profiler browse window)
 $(LI Code Coverage support)
 $(LI Support for the Error List, Code Definition window, Object Browser, and Class View)
 $(LI C++ to D Conversion Wizard)
 $(LI Support for building with $(LINK2 https://github.com/ldc-developers/ldc, LDC) and
      $(LINK2 https://github.com/D-Programming-GDC/GDC, GDC)
      instead of DMD)
 $(LI Written mostly in D)
)
) $(TD
$(LINK2 images/fullvs.png, <img src="images/fullvs.png" width="100%"/>)
))

$(LINK2 Features.html, Read more...)

$(H2 News)

$(P $(LINK2 VersionHistory.html, Full version history and complete details...)
)

2025-07-15 Version 1.5.0
 $(UL
    $(LI installer now supports VS 2026)
    $(LI full installer now bundled with DMD 2.113.0 and LDC 1.43.0)
    $(LI dmdserver executable selected by installed dmd version (2.110+ - 2.114-beta1))
    $(LI VC project integration: generic support for future versions 18.1-18.15)
 )

2025-07-15 Version 1.4.1
 $(UL
  $(LI lots of improvements to the mago debugger extension)
  $(LI dmdserver updated to frontend of DMD 2.111.0)
  $(LI full installer now bundled with DMD 2.111.0 and LDC 1.40.1)
  $(LI VC project integration: added support to build for ARM64 with LDC)
 )

2025-03-14 Version 1.4.0
 $(UL
  $(LI fixed msbuild integration for VS 2022 17.5 - 17.14)
  $(LI now works with Visual Studio for Windows on ARM64)
  $(LI dmdserver updated to frontend of DMD 2.110.0, improved completion)
  $(LI full installer now bundled with DMD 2.110.0 and LDC 1.40.0)
  $(LI for better responsiveness mago debug extension now executes visualizer calls asynchronously)
 )


$(LINK2 VersionHistory.html, more...)

$(H2 Download)

$(P The latest installer and older versions can be downloaded
$(LINK2 https://github.com/dlang/visuald/releases, here).
)

Macros:
	TITLE=Visual D
