module ctfe_inst;

// Each instance of Chain calls the next one, so the interpreter runs code that
// was generated by several instantiations at once.
struct Chain(int n)
{
	int value;

	static if (n == 0)
		int add(int acc)
		{
			return acc + value;				// BP_BOTTOM
		}
	else
		int add(int acc)
		{
			return Chain!(n - 1)(value + n).add(acc);	// BP_RECURSE
		}
}

// A function template instantiated by an explicit argument list.
int scale(int n)(int v)
{
	return n * v;						// BP_SCALE
}

enum int r = Chain!3(1).add(0);			// BP_CHAIN
enum int s = scale!7(6);				// BP_SCALE_CALL
